# Snapshot of the first integration repository's pyproject.toml dependencies.
# Refresh this image when PolicyAnalysisSystem changes its Python dependencies.
FROM python:3.12
RUN pip install --no-cache-dir --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    'alembic>=1.14,<2' 'apscheduler>=3.11,<4' 'argon2-cffi>=23.1,<26' \
    'defusedxml>=0.7,<1' 'fastapi>=0.115,<1' 'httpx>=0.28,<1' \
    'idna>=3.10,<4' 'jieba>=0.42,<1' 'pydantic>=2.10,<3' \
    'sqlalchemy>=2.0,<3' 'uvicorn[standard]>=0.34,<1' \
    'pytest>=8.3,<9' 'pytest-cov>=6,<7'
WORKDIR /workspace
