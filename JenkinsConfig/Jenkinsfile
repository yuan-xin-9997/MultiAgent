pipeline {
    agent any

    environment {
        DEPLOY_DIR = '/opt/multiagent'
        SERVICE_NAME = 'multiagent.service'
        DEPLOY_HOST = '127.0.0.1'
    }

    stages {
        stage('Stop service') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'DEPLOY_USER', passwordVariable: 'DEPLOY_PASSWORD')]) {
                    sh '''
                        export SSHPASS="$DEPLOY_PASSWORD"
                        printf '%s\\n' "$DEPLOY_PASSWORD" | sshpass -e ssh -o StrictHostKeyChecking=no "$DEPLOY_USER@$DEPLOY_HOST" "sudo -S systemctl stop '$SERVICE_NAME' || true"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'DEPLOY_USER', passwordVariable: 'DEPLOY_PASSWORD')]) {
                    sh '''
                        export SSHPASS="$DEPLOY_PASSWORD"
                        tar --exclude=.git --exclude=.data --exclude=__pycache__ -czf - -C "$WORKSPACE" . \
                          | sshpass -e ssh -o StrictHostKeyChecking=no "$DEPLOY_USER@$DEPLOY_HOST" "mkdir -p /tmp/multiagent-deploy && tar -xzf - -C /tmp/multiagent-deploy"
                        sshpass -e ssh -o StrictHostKeyChecking=no "$DEPLOY_USER@$DEPLOY_HOST" "mkdir -p '$DEPLOY_DIR' && rsync -a --delete --exclude=.git/ --exclude=.data/ --exclude=__pycache__/ /tmp/multiagent-deploy/ '$DEPLOY_DIR/'"
                    '''
                }
            }
        }

        stage('Configure service') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'DEPLOY_USER', passwordVariable: 'DEPLOY_PASSWORD')]) {
                    sh '''
                        export SSHPASS="$DEPLOY_PASSWORD"
                        unit_b64=$(printf '%b' "[Unit]\nDescription=MultiAgent Coding Web and worker\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=simple\nUser=$DEPLOY_USER\nWorkingDirectory=$DEPLOY_DIR\nEnvironmentFile=/home/$DEPLOY_USER/.config/multiagent/env\nEnvironment=MA_HOST=0.0.0.0\nExecStart=/usr/bin/python3 $DEPLOY_DIR/app.py\nRestart=always\nRestartSec=5\nUMask=0077\nNoNewPrivileges=true\nMemoryMax=4G\n\n[Install]\nWantedBy=multi-user.target\n" | base64 -w0)
                        sshpass -e ssh -o StrictHostKeyChecking=no "$DEPLOY_USER@$DEPLOY_HOST" "printf '%s\\n' '$DEPLOY_PASSWORD' | sudo -S bash -c 'echo $unit_b64 | base64 -d > /etc/systemd/system/$SERVICE_NAME && systemctl daemon-reload && systemctl enable $SERVICE_NAME'"
                    '''
                }
            }
        }

        stage('Start service') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'DEPLOY_USER', passwordVariable: 'DEPLOY_PASSWORD')]) {
                    sh '''
                        export SSHPASS="$DEPLOY_PASSWORD"
                        printf '%s\\n' "$DEPLOY_PASSWORD" | sshpass -e ssh -o StrictHostKeyChecking=no "$DEPLOY_USER@$DEPLOY_HOST" "sudo -S systemctl start '$SERVICE_NAME'"
                    '''
                }
            }
        }
    }

    post {
        failure {
            withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'DEPLOY_USER', passwordVariable: 'DEPLOY_PASSWORD')]) {
                sh '''
                    export SSHPASS="$DEPLOY_PASSWORD"
                    printf '%s\\n' "$DEPLOY_PASSWORD" | sshpass -e ssh -o StrictHostKeyChecking=no "$DEPLOY_USER@$DEPLOY_HOST" "sudo -S systemctl start '$SERVICE_NAME' || true"
                '''
            }
        }
    }
}
